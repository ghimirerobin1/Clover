# Server-only configuration for the FastAPI proxy in /server.
# Copy to server/.env. NEVER put these in the Expo app (EXPO_PUBLIC_* vars ship inside the bundle).

# 1 = serve built-in fixtures, no Clover account needed. 0 = talk to real Clover.
CLOVER_MOCK=1

# Required when CLOVER_MOCK=0
CLOVER_API_TOKEN=
CLOVER_MERCHANT_ID=
# Sandbox: https://sandbox.dev.clover.com   US production: https://api.clover.com
CLOVER_BASE_URL=https://sandbox.dev.clover.com

# Client-side throttle, kept below Clover's per-token limit (VERIFY current limit).
CLOVER_RATE_LIMIT_PER_SEC=8
CLOVER_RATE_LIMIT_BURST=8
CLOVER_MAX_GET_ATTEMPTS=4
CLOVER_TIMEOUT_SEC=15

# SQLite file for device keys (hashed), pairing codes, idempotency and audit log.
DATABASE_PATH=stockroom.sqlite3
PAIRING_CODE_TTL_SEC=600
PAIRING_MAX_FAILURES_PER_MIN=10
